# ─── Deployment mode ──────────────────────────────────────────────────────
# middleware (default): one-way egress to an external vendor fraud platform
#   (inference only). Requires the vendor params below.
# standalone: no external system. Vendor params are not required; anonymized
#   signals are written to STANDALONE_SINK_DIR instead.
GATEWAY_MODE=middleware

# ─── Mosaic keying (independent of GATEWAY_MODE) ──────────────────────────
# bank (default): every identity/destination mosaic folds in this
#   institution's own BANK_SALT, so it's not reproducible by anyone lacking
#   that secret. MOSAIC_PEPPER below is optional in this mode.
# regional: national-ID mosaics are keyed on MOSAIC_PEPPER alone (no
#   BANK_SALT), exactly like the pre-v3 scheme - every gateway sharing that
#   pepper derives the same mosaic for the same person. This is a deliberate
#   re-introduction of cross-gateway derivability (anyone holding the pepper
#   can enumerate the BVN/NIN space); only opt in for a known cross-gateway
#   use case. MOSAIC_PEPPER is REQUIRED in this mode - startup fails fast if
#   it's unset.
MOSAIC_KEYING=bank

# ─── Vendor platform params (required only in middleware mode) ───────────
INSTITUTION_ID=YOUR_INSTITUTION_ID
API_KEY=YOUR_API_KEY
HMAC_SECRET=YOUR_HMAC_SECRET
# No built-in default: middleware mode fails fast at startup if this is unset
# rather than silently posting to a placeholder host.
HUB_API_URL=https://your-vendor.example.com/api/v1/signals

# ─── Local params (never sent anywhere) ───────────────────────────────────
# Required in both modes: drives local pseudonymization regardless of
# whether signals leave the bank.
BANK_SALT=your_bank_salt_minimum_32_characters_long_for_security
# Additional key material for mosaic derivation - see MOSAIC_KEYING above.
# Optional when MOSAIC_KEYING=bank (the default): BANK_SALT alone already
# keys every mosaic; if set, this is folded in too as defense in depth
# (leaking either secret alone must not reproduce a mosaic). REQUIRED when
# MOSAIC_KEYING=regional - startup fails fast if unset in that mode.
# REGIONAL_PEPPER is accepted as a backward-compatible alias for this
# variable (if both are set, MOSAIC_PEPPER wins).
MOSAIC_PEPPER=your_mosaic_pepper_value

# ─── Standalone mode only ─────────────────────────────────────────────────
# Directory for the local sink's newline-delimited JSON files (one per UTC
# day). Ignored in middleware mode. No built-in rotation/retention - old
# files accumulate until an operator archives or deletes them.
# Docker uses /sink (volume-backed); ./sink works for local runs.
STANDALONE_SINK_DIR=./sink

# ─── Optional ───────────────────────────────────────────────────────────
GATEWAY_PORT=8080
REPORTING_THRESHOLD=10000

# Inbound auth: core banking systems must present this key on /process
# (Authorization: Bearer <key> or X-Gateway-API-Key). Strongly recommended.
INBOUND_API_KEY=

# TLS for the gateway listener (PII arrives in cleartext without it)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Durable spool: /process persists anonymized signals and returns 202; a
# background forwarder delivers them, so a destination outage (vendor down,
# or a full/unwritable sink disk) doesn't lose signals.
# Leave empty for synchronous delivery (200/502 per request).
# Docker uses /spool (volume-backed); ./spool works for local runs.
SPOOL_DIR=./spool
SPOOL_MAX_DEPTH=10000

# By default (unset, or anything other than "false"), Enqueue fsyncs the
# signal's temp file before rename and the spool directory after it, so the
# 202 above means the signal survives a HOST POWER LOSS, not just a
# gateway process crash/restart. Set to "false" only if you have measured
# your own storage and accepted the risk: with it disabled, a power loss
# shortly after a burst of 202s can lose signals the core banking system
# was already told were durably queued, with no durable trace anywhere. See
# README's "Durable spool" section for measured fsync-on vs fsync-off
# throughput numbers.
SPOOL_FSYNC=true

# Egress audit log: a separate, durable, append-only record written ONLY
# after a destination CONFIRMS delivery (never at enqueue/attempt) - proof
# of what actually left the bank, since the spool deletes a signal's file
# the instant delivery succeeds. See README's "Egress audit log" section.
# Leave empty to disable - the gateway itself treats unset as off by
# default (recommended for compliance, but with a loud startup warning if
# left off, same as SPOOL_DIR). No built-in rotation/retention - old files
# accumulate until an operator archives or deletes them.
EGRESS_AUDIT_DIR=./audit
# Store the full delivered payload alongside its digest, not just the
# digest (the default). The payload is pseudonymized but still personal
# data, so a second copy is a second liability - leave this off unless you
# specifically need it.
EGRESS_AUDIT_STORE_PAYLOAD=false

# Readiness thresholds for /readyz (spool backlog/staleness, and egress
# audit log write failures - NOT liveness; see the /readyz row in README's
# API Endpoints section for why this must never be wired to an
# auto-restart action). Uncomment to override the defaults shown here.
# READINESS_MAX_DEPTH_RATIO=0.95
# READINESS_MAX_STALENESS_SECONDS=900
# READINESS_MAX_AUDIT_FAILURES=3
